<odoo>
    <record id="check_in_wizard_form" model="ir.ui.view">
        <field name="name">check in wizard form</field>
        <field name="model">check_in.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="phone"/>
                    <field name="barcode"/>
                    <field name="session_type"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="check_in_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="check_in_wizard_action" model="ir.actions.act_window">
        <field name="name">check in confirm action</field>
        <field name="res_model">check_in.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>

    <menuitem id="menu_check_in_root"
          name="Check In"
          web_icon="silver_gym,static/description/icon.png"/>

    <menuitem id="menu_check_in"
              name="Check In"
              parent="menu_check_in_root"
              action="check_in_wizard_action"/>
</odoo>