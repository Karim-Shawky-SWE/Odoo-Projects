<odoo>
    <record id="gym_attendance_view_view_list" model="ir.ui.view">
        <field name="name">gym.attendance.view</field>
        <field name="model">gym.attendance.created</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="check_in"/>
                <field name="session_type"/>
            </list>
        </field>
    </record>

    <record id="gym_attendance_view_view_form" model="ir.ui.view">
        <field name="name">gym.attendance.view</field>
        <field name="model">gym.attendance.created</field>
        <field name="arch" type="xml">
            <form string="Form Title">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="check_in"/>
                        </group>
                        <group>
                            <field name="session_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gym_attendance_view_action" model="ir.actions.act_window">
        <field name="name">Gym Attendance View</field>
        <field name="res_model">gym.attendance.created</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="gym_attendance_view_menu" name="Clients Attendance" action="gym_attendance_view_action" />
</odoo>