<odoo>
    <record id="estate_property_image_view_view_list" model="ir.ui.view">
        <field name="name">estate.property.image.view.view.list</field>
        <field name="model">estate.property.image</field>
        <field name="arch" type="xml">
            <list string="Images List">
                <field name="name"/>
                <field name="property_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="estate_property_image_view_view_form" model="ir.ui.view">
        <field name="name">estate.property.image.view.view.form</field>
        <field name="model">estate.property.image</field>
        <field name="arch" type="xml">
            <form string="Images Form">
                <header>
                    <!-- Buttons and statusbar go here -->
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label for="name" string="Image Name"/>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="image"/>
                            <field name="sequence"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_image_view_action" model="ir.actions.act_window">
        <field name="name">Estate Property Image View</field>
        <field name="res_model">estate.property.image</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="estate_property_image_view" name="Property Images" parent="Real_Estate_property_type_menu" action="estate_property_image_view_action" sequence="46"/>
</odoo>